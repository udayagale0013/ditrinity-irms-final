# REQUIRED
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret

# Local development login only. This does NOT create a database user.
DEV_AUTH_EMAIL=admin@ditrinity.com
DEV_AUTH_PASSWORD=change-me

# Microsoft Entra ID - production SSO
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
NEXTAUTH_URL=http://localhost:3000

# AI - Azure OpenAI / compatible endpoint. Leave blank to disable AI calls.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_API_VERSION=2024-10-21

# Zoho People - optional. The test adapter works without these values.
ZOHO_BASE_URL=https://people.zoho.in
ZOHO_ACCESS_TOKEN=
ZOHO_EMPLOYEE_ENDPOINT=/people/api/forms/P_EmployeeView/records
ZOHO_LEAVE_ENDPOINT=/people/api/forms/leave/getLeaveEntries
ZOHO_TIMESHEET_ENDPOINT=/people/api/timetracker/gettimesheetdetails

# Power BI secure embed configuration. App returns a clear configuration error if absent.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=

# Microsoft Graph / SharePoint integration boundary
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_PIPELINE_FILE_ID=

# Runtime
APP_URL=http://localhost:3000
